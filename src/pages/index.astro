---
import BaseLayout from '../layouts/BaseLayout.astro';
import TripCard from '../components/TripCard.astro';
import HowItWorks from '../components/HowItWorks.astro';
import TrustSection from '../components/TrustSection.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import StampBadge from '../components/StampBadge.astro';
import {
  MONTHS,
  SECTOR_LIST,
  TRIPS,
  getTripsBySector,
  getWhatsAppUrl,
} from '../data/viagens';

const featuredTrips = TRIPS.filter((t) => t.featured).slice(0, 6);
const nextFeaturedTrip = featuredTrips[0] ?? TRIPS[0];
const heroWaUrl = getWhatsAppUrl(
  'Olá, São Bento Turismo! Quero conhecer os roteiros disponíveis e valores para as próximas viagens.'
);
const groupWaUrl = getWhatsAppUrl(
  'Olá, São Bento Turismo! Gostaria de solicitar um orçamento para grupo fechado / família / melhor idade.'
);

const marqueeDestinations = [
  { name: 'Jericoacoara', italic: false },
  { name: 'Maragogi', italic: true },
  { name: 'Aparecida & Canção Nova', italic: false },
  { name: 'Lençóis Maranhenses', italic: true },
  { name: 'Foz do Iguaçu (Aéreo)', italic: false },
  { name: 'Guaramiranga', italic: true },
  { name: 'Hotel Thermas', italic: false },
  { name: 'Chapada das Mesas', italic: true },
  { name: 'Cimbres (PE)', italic: false },
  { name: 'São Miguel do Gostoso', italic: true },
];
---

<BaseLayout
  title="São Bento Turismo | Excursões, Passeios e Peregrinações saindo de Fortaleza - CE"
  description="Há 20 anos realizando viagens em grupo saindo de Fortaleza: passeios no Ceará, excursões pelo Nordeste, turismo religioso e pacotes aéreos especiais."
  currentPath="/"
>
  <!-- HERO EDITORIAL -->
  <section class="home-hero">
    <img
      src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=80"
      alt=""
      class="home-hero-bg"
      aria-hidden="true"
      onerror="this.style.display='none'"
    />
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="hero-badge">✦ Desde 2006 em Fortaleza • 20 anos de estrada</span>
        <h1>
          Viajar em grupo
          <span class="h1-photo-pill" aria-hidden="true">
            <img
              src="https://images.unsplash.com/photo-1506929562872-bb421503ef21?auto=format&fit=crop&w=260&q=80"
              alt=""
              width="92"
              height="44"
              onerror="this.parentElement.style.display='none'"
            />
          </span>
          com <span class="h1-accent">alegria, fé</span> e organização de perto.
        </h1>
        <p>
          Passeios pelo Ceará, excursões pelo Nordeste, turismo religioso e viagens especiais saindo de Fortaleza.
          Escolha seu próximo destino e fale direto com a nossa equipe no WhatsApp.
        </p>

        <div class="hero-actions">
          <a href="/calendario" class="btn btn-primary">
            Ver Calendário 2026 / 2027 ({TRIPS.length} saídas)
          </a>
          <a href={heroWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-light">
            <WhatsAppIcon size={18} />
            Falar no WhatsApp agora
          </a>
        </div>

        <div class="hero-trust">
          <div>
            <strong>20 anos</strong>
            <span>de tradição (2006–2026)</span>
          </div>
          <div>
            <strong>{TRIPS.length} saídas</strong>
            <span>programadas até Maio/2027</span>
          </div>
          <div>
            <strong>4 setores</strong>
            <span>CE, Nordeste, Fé e Aéreo</span>
          </div>
        </div>
      </div>

      <!-- COMPOSIÇÃO FOTOGRÁFICA EDITORIAL EM CAMADAS -->
      <div class="hero-collage">
        <div class="hero-arch-frame">
          <img
            src="https://images.unsplash.com/photo-1510414842594-a61c69b5ae57?auto=format&fit=crop&w=900&q=80"
            alt="Praia de águas cristalinas do Nordeste em excursão da São Bento Turismo"
            width="420"
            height="500"
            onerror="this.style.display='none'"
          />
          <div class="hero-arch-caption">
            <span>Litoral • Serra • Fé • Brasil</span>
          </div>
        </div>

        <div class="hero-stamp-wrap">
          <StampBadge size={114} variant="gold" />
        </div>

        <div class="hero-polaroid" aria-hidden="true">
          <img
            src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=420&q=80"
            alt=""
            width="160"
            height="120"
            onerror="this.parentElement.style.display='none'"
          />
          <span>“Vamos viajar, meu povo!”</span>
        </div>

        <a href={`/viagem/${nextFeaturedTrip.id}`} class="hero-ticket-float">
          <span class="htf-kicker">Próximo destaque</span>
          <strong>{nextFeaturedTrip.cardTitle ?? nextFeaturedTrip.title}</strong>
          <span class="htf-meta">{nextFeaturedTrip.dates} • {nextFeaturedTrip.month} →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- BARRA DE BUSCA RÁPIDA (ESTILO BOOKING) -->
  <section class="quick-search-wrap" aria-label="Busca rápida de viagens">
    <div class="container">
      <form class="quick-search-bar" action="/calendario" method="get">
        <div class="qs-field">
          <label for="qs-setor">Tipo de viagem / Setor</label>
          <select id="qs-setor" name="setor">
            <option value="all">Todos os setores ({TRIPS.length} saídas)</option>
            {SECTOR_LIST.map((s) => (
              <option value={s.slug}>{s.title}</option>
            ))}
          </select>
        </div>

        <div class="qs-field">
          <label for="qs-mes">Mês da viagem</label>
          <select id="qs-mes" name="mes">
            <option value="all">Todos os meses (Nov/26 – Mai/27)</option>
            {MONTHS.map((m) => (
              <option value={m}>{m}</option>
            ))}
          </select>
        </div>

        <button type="submit" class="btn btn-primary qs-submit">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          Buscar saídas
        </button>
      </form>
    </div>
  </section>

  <!-- FAIXA EDITORIAL CONTÍNUA DE DESTINOS (MARQUEE) -->
  <div class="dest-marquee" aria-label="Principais destinos programados">
    <div class="dest-marquee-track">
      <div class="dest-marquee-group">
        {marqueeDestinations.map((dest) => (
          <>
            <span class:list={['marquee-item', { 'marquee-serif': dest.italic }]}>{dest.name}</span>
            <span class="marquee-star" aria-hidden="true">✦</span>
          </>
        ))}
      </div>
      <div class="dest-marquee-group" aria-hidden="true">
        {marqueeDestinations.map((dest) => (
          <>
            <span class:list={['marquee-item', { 'marquee-serif': dest.italic }]}>{dest.name}</span>
            <span class="marquee-star">✦</span>
          </>
        ))}
      </div>
    </div>
  </div>

  <!-- 4 SETORES DE TURISMO (BENTO GRID EDITORIAL) -->
  <section class="section" id="setores">
    <div class="container">
      <div class="section-header center">
        <span class="eyebrow">Nossos Setores de Turismo</span>
        <h2 class="section-title">
          Um roteiro ideal para cada <span class="h2-serif">momento</span> da sua viagem
        </h2>
        <p class="section-subtitle">
          Cada setor tem uma página dedicada com os destinos programados, diferenciais e contato direto para reserva.
        </p>
      </div>

      <div class="bento-sectors">
        {SECTOR_LIST.map((sector, idx) => {
          const count = getTripsBySector(sector.slug).length;
          const isWide = idx === 0 || idx === 3;
          const isReligious = sector.slug === 'turismo-religioso';
          return (
            <a
              href={`/${sector.slug}`}
              class:list={[
                'sector-bento-card',
                { 'sector-bento-wide': isWide, 'sector-bento-arch': isReligious },
              ]}
            >
              <div class="sector-bento-media" style={`background: ${sector.heroGradient};`}>
                <img
                  src={sector.heroImage}
                  alt={sector.title}
                  width="800"
                  height="480"
                  class="sector-bento-img"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
                <div class="sector-bento-overlay"></div>
                <div class="sector-bento-frame" aria-hidden="true"></div>

                <div class="sector-bento-top">
                  <span class="sector-count">{count} {count === 1 ? 'saída' : 'saídas'}</span>
                  <span class="sector-num">0{idx + 1}</span>
                </div>

                <div class="sector-bento-heading">
                  <span class="sector-kicker">{sector.eyebrow}</span>
                  <h3>{sector.title}</h3>
                </div>
              </div>

              <div class="sector-bento-body">
                <p>{sector.tagline}</p>
                <span class="sector-cta">Ver roteiros do setor →</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- DESTAQUES DA AGENDA -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="eyebrow eyebrow-blue">Destaques 2026 / 2027</span>
          <h2 class="section-title">
            Viagens <span class="h2-serif">mais procuradas</span>
          </h2>
          <p class="section-subtitle">
            Garanta sua vaga com antecedência. Clique em qualquer roteiro para ver os detalhes, compartilhar com a família ou reservar no WhatsApp.
          </p>
        </div>
        <a href="/calendario" class="btn btn-outline">Ver todas as {TRIPS.length} saídas →</a>
      </div>

      <div class="grid-3">
        {featuredTrips.map((trip) => (
          <TripCard trip={trip} showSectorBadge={true} />
        ))}
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <HowItWorks />

  <!-- PROVA SOCIAL & CONFIANÇA -->
  <TrustSection />

  <!-- BANNER GRUPOS FECHADOS -->
  <section class="section">
    <div class="container">
      <div class="cta-box">
        <div>
          <span class="hero-eyebrow-light">Grupos Fechados • Paróquias • Melhor Idade • Empresas</span>
          <h2>
            Quer montar uma excursão <span class="h1-accent">exclusiva</span> para o seu grupo?
          </h2>
          <p>
            Organizamos roteiros personalizados para romarias, associações, famílias, escolas e eventos saindo de Fortaleza.
          </p>
        </div>
        <div class="cta-box-actions">
          <a href={groupWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
            <WhatsAppIcon size={18} />
            Solicitar orçamento no WhatsApp
          </a>
          <a href="/sobre" class="btn btn-outline-light">
            Conhecer nossa história
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO EDITORIAL */
  .home-hero {
    background: linear-gradient(135deg, #071e30 0%, #0d3c61 52%, #1268a3 100%);
    color: #ffffff;
    padding: 4.25rem 0 6.25rem;
    position: relative;
    overflow: hidden;
  }

  .home-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.14;
    pointer-events: none;
    z-index: 0;
  }

  .home-hero::before {
    content: '';
    position: absolute;
    width: 560px;
    height: 560px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(253, 230, 138, 0.22) 0%, transparent 68%);
    top: -180px;
    right: -120px;
    pointer-events: none;
    z-index: 0;
  }

  .home-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 22px 22px;
    pointer-events: none;
    z-index: 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(253, 230, 138, 0.42);
    color: var(--sb-warm-light);
    backdrop-filter: blur(6px);
    padding: 0.42rem 1rem;
    border-radius: 999px;
    margin-bottom: 1.35rem;
  }

  .hero-copy h1 {
    color: #ffffff;
    font-size: clamp(2.35rem, 4.5vw, 3.65rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  /* Mini foto pílula inserida dentro do H1 */
  .h1-photo-pill {
    display: inline-flex;
    vertical-align: middle;
    width: 2.05em;
    height: 0.86em;
    border-radius: 999px;
    overflow: hidden;
    border: 2px solid rgba(253, 230, 138, 0.8);
    margin: 0 0.12em 0.12em;
    box-shadow: 0 8px 20px rgba(7, 30, 48, 0.35);
  }

  .h1-photo-pill img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-copy p {
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.1rem;
    max-width: 580px;
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 2.25rem;
    margin-top: 2.35rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .hero-trust strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--sb-warm-light);
    line-height: 1.1;
  }

  .hero-trust span {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.86);
  }

  /* COMPOSIÇÃO FOTOGRÁFICA EM ARCO + POLAROID + SELO + TICKET */
  .hero-collage {
    position: relative;
    padding: 1.25rem 1.4rem 2.2rem 2.2rem;
    max-width: 460px;
    margin-left: auto;
    width: 100%;
  }

  .hero-arch-frame {
    position: relative;
    aspect-ratio: 4 / 4.75;
    border-radius: 210px 210px 26px 26px;
    overflow: hidden;
    border: 3px solid rgba(255, 255, 255, 0.32);
    box-shadow: 0 28px 60px rgba(4, 18, 30, 0.42);
    background: linear-gradient(160deg, #0e4a73 0%, #1b7fc1 100%);
  }

  .hero-arch-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-arch-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.4rem 1.25rem 1rem;
    background: linear-gradient(180deg, transparent 0%, rgba(7, 30, 48, 0.78) 100%);
    text-align: center;
  }

  .hero-arch-caption span {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
  }

  .hero-stamp-wrap {
    position: absolute;
    top: -0.35rem;
    right: 0;
    z-index: 4;
  }

  .hero-polaroid {
    position: absolute;
    left: 0;
    bottom: 4.5rem;
    width: 158px;
    background: #ffffff;
    padding: 7px 7px 11px;
    border-radius: 12px;
    box-shadow: 0 18px 36px rgba(7, 30, 48, 0.34);
    transform: rotate(-4deg);
    z-index: 3;
    transition: transform 0.25s ease;
  }

  .hero-polaroid:hover {
    transform: rotate(-1deg) scale(1.03);
  }

  .hero-polaroid img {
    width: 100%;
    height: 102px;
    object-fit: cover;
    border-radius: 7px;
  }

  .hero-polaroid span {
    display: block;
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 700;
    font-size: 0.96rem;
    color: var(--sb-blue-deep);
    text-align: center;
    margin-top: 6px;
    line-height: 1.15;
  }

  .hero-ticket-float {
    position: absolute;
    right: 0.25rem;
    bottom: 0;
    z-index: 5;
    max-width: 265px;
    background: var(--sb-surface);
    color: var(--sb-blue-deep);
    border: 1px solid var(--sb-border);
    border-left: 4px solid var(--sb-red);
    border-radius: 16px;
    padding: 0.9rem 1.1rem;
    box-shadow: 0 18px 40px rgba(7, 30, 48, 0.34);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hero-ticket-float:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 46px rgba(7, 30, 48, 0.42);
  }

  .htf-kicker {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--sb-red-dark);
    margin-bottom: 0.15rem;
  }

  .hero-ticket-float strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 1rem;
    line-height: 1.25;
    color: var(--sb-blue-deep);
  }

  .htf-meta {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--sb-blue-action);
    margin-top: 0.2rem;
  }

  /* Barra de busca rápida */
  .quick-search-wrap {
    margin-top: -2.6rem;
    position: relative;
    z-index: 10;
  }

  .quick-search-bar {
    background: #ffffff;
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.45rem;
    box-shadow: var(--shadow-lg);
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 1rem;
    align-items: end;
  }

  .qs-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .qs-field label {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sb-blue-dark);
  }

  .qs-field select {
    font-family: inherit;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--sb-blue-deep);
    background: var(--sb-bg);
    border: 1px solid var(--sb-border-strong);
    border-radius: 12px;
    padding: 0.84rem 1rem;
    cursor: pointer;
  }

  .qs-submit {
    padding: 0.9rem 1.75rem;
    white-space: nowrap;
  }

  /* FAIXA MARQUEE EDITORIAL DE DESTINOS */
  .dest-marquee {
    margin-top: 2.5rem;
    background: var(--sb-bg-warm);
    border-top: 1px solid var(--sb-border);
    border-bottom: 1px solid var(--sb-border);
    padding: 1rem 0;
    overflow: hidden;
  }

  .dest-marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 38s linear infinite;
  }

  .dest-marquee:hover .dest-marquee-track {
    animation-play-state: paused;
  }

  .dest-marquee-group {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    padding-right: 1.35rem;
  }

  .marquee-item {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sb-blue-deep);
    white-space: nowrap;
  }

  .marquee-serif {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 1.42rem;
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
    color: var(--sb-blue-action);
  }

  .marquee-star {
    color: var(--sb-red);
    font-size: 0.85rem;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* BENTO GRID EDITORIAL DOS 4 SETORES */
  .bento-sectors {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .sector-bento-card {
    grid-column: span 5;
    background: var(--sb-surface);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .sector-bento-wide {
    grid-column: span 7;
  }

  .sector-bento-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--sb-border-strong);
  }

  .sector-bento-media {
    position: relative;
    min-height: 235px;
    padding: 1.45rem 1.5rem;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  /* Detalhe de arco sutil para Turismo Religioso */
  .sector-bento-arch .sector-bento-media {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .sector-bento-arch .sector-bento-frame {
    border-radius: 120px 120px 12px 12px;
    border-color: rgba(253, 230, 138, 0.55);
    opacity: 0.72;
    transform: scale(1);
  }

  .sector-bento-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 0;
  }

  .sector-bento-card:hover .sector-bento-img {
    transform: scale(1.06);
  }

  .sector-bento-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(9, 35, 56, 0.44) 0%, rgba(9, 35, 56, 0.86) 100%);
    z-index: 1;
  }

  .sector-bento-frame {
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 14px;
    opacity: 0;
    transform: scale(0.97);
