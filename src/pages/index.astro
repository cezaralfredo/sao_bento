---
import BaseLayout from '../layouts/BaseLayout.astro';
import TripCard from '../components/TripCard.astro';
import HowItWorks from '../components/HowItWorks.astro';
import TrustSection from '../components/TrustSection.astro';
import {
  COMPANY,
  MONTHS,
  SECTOR_LIST,
  TRIPS,
  getTripsBySector,
  getWhatsAppUrl,
} from '../data/viagens';

const featuredTrips = TRIPS.filter((t) => t.featured);
const heroWaUrl = getWhatsAppUrl(
  'Olá, São Bento Turismo! Quero conhecer os roteiros disponíveis e valores para as próximas viagens.'
);
const groupWaUrl = getWhatsAppUrl(
  'Olá, São Bento Turismo! Gostaria de solicitar um orçamento para grupo fechado / família / melhor idade.'
);
---

<BaseLayout
  title="São Bento Turismo | Excursões, Passeios e Peregrinações saindo de Fortaleza - CE"
  description="Há 20 anos realizando viagens em grupo saindo de Fortaleza: passeios no Ceará, excursões pelo Nordeste, turismo religioso e pacotes aéreos especiais."
  currentPath="/"
>
  <!-- HERO -->
  <section class="home-hero">
    <img
      src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=80"
      alt=""
      class="home-hero-bg"
      aria-hidden="true"
      onerror="this.style.display='none'"
    />
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="hero-badge">Desde 2006 em Fortaleza • 20 anos de estrada</span>
        <h1>
          Viajar em grupo com <span class="highlight">organização, alegria</span> e acompanhamento de perto.
        </h1>
        <p>
          Passeios pelo Ceará, excursões pelo Nordeste, turismo religioso e viagens especiais saindo de Fortaleza.
          Escolha seu próximo destino e fale direto com a nossa equipe no WhatsApp.
        </p>

        <div class="hero-actions">
          <a href="/calendario" class="btn btn-primary">
            Ver Calendário 2026 / 2027 ({TRIPS.length} saídas)
          </a>
          <a href={heroWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
            Falar no WhatsApp agora
          </a>
        </div>

        <div class="hero-trust">
          <div>
            <strong>20 anos</strong>
            <span>de tradição (2006–2026)</span>
          </div>
          <div>
            <strong>{TRIPS.length} saídas</strong>
            <span>programadas até Maio/2027</span>
          </div>
          <div>
            <strong>4 setores</strong>
            <span>CE, Nordeste, Fé e Aéreo</span>
          </div>
        </div>
      </div>

      <div class="hero-panel">
        <div class="hero-panel-card">
          <span class="panel-label">Próxima grande agenda</span>
          <h2>Vamos viajar, meu povo!</h2>
          <p>
            Confira nossos principais embarques confirmados saindo de Fortaleza:
          </p>
          <ul class="hero-mini-list">
            <li>
              <span class="dot"></span>
              <div>
                <strong>Novembro e Dezembro</strong>
                <span>Guaramiranga, Camocim, Fortim, Jeri, Mundaú e Réveillon no Hotel Thermas</span>
              </div>
            </li>
            <li>
              <span class="dot dot-red"></span>
              <div>
                <strong>Janeiro e Fevereiro 2027</strong>
                <span>São Miguel do Gostoso, Aracaju, Maragogi, Cimbres e Carnaval em Petrolina</span>
              </div>
            </li>
            <li>
              <span class="dot"></span>
              <div>
                <strong>Abril e Maio 2027</strong>
                <span>Foz do Iguaçu (Aéreo), Aparecida & Canção Nova, Chapada das Mesas e Lençóis</span>
              </div>
            </li>
          </ul>
          <a href="/calendario" class="btn btn-blue panel-btn">
            Explorar todas as datas →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- BARRA DE BUSCA RÁPIDA (ESTILO BOOKING) -->
  <section class="quick-search-wrap" aria-label="Busca rápida de viagens">
    <div class="container">
      <form class="quick-search-bar" action="/calendario" method="get">
        <div class="qs-field">
          <label for="qs-setor">Tipo de viagem / Setor</label>
          <select id="qs-setor" name="setor">
            <option value="all">Todos os setores ({TRIPS.length} saídas)</option>
            {SECTOR_LIST.map((s) => (
              <option value={s.slug}>{s.title}</option>
            ))}
          </select>
        </div>

        <div class="qs-field">
          <label for="qs-mes">Mês da viagem</label>
          <select id="qs-mes" name="mes">
            <option value="all">Todos os meses (Nov/26 – Mai/27)</option>
            {MONTHS.map((m) => (
              <option value={m}>{m}</option>
            ))}
          </select>
        </div>

        <button type="submit" class="btn btn-primary qs-submit">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          Buscar saídas
        </button>
      </form>
    </div>
  </section>

  <!-- 4 SETORES DE TURISMO -->
  <section class="section" id="setores">
    <div class="container">
      <div class="section-header center">
        <span class="eyebrow">Nossos Setores de Turismo</span>
        <h2 class="section-title">Um roteiro ideal para cada momento da sua viagem</h2>
        <p class="section-subtitle">
          Cada setor tem uma página dedicada com os destinos programados, diferenciais e contato direto para reserva.
        </p>
      </div>

      <div class="grid-4">
        {SECTOR_LIST.map((sector) => {
          const count = getTripsBySector(sector.slug).length;
          return (
            <a href={`/${sector.slug}`} class="sector-card">
              <div class="sector-card-top" style={`background: ${sector.heroGradient};`}>
                <img
                  src={sector.heroImage}
                  alt={sector.title}
                  class="sector-card-img"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
                <div class="sector-card-overlay"></div>
                <span class="sector-count">{count} {count === 1 ? 'saída' : 'saídas'}</span>
                <h3>{sector.title}</h3>
              </div>
              <div class="sector-card-body">
                <span class="sector-eyebrow">{sector.eyebrow}</span>
                <p>{sector.tagline}</p>
                <span class="sector-cta">Ver roteiros do setor →</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- DESTAQUES DA AGENDA -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="eyebrow eyebrow-blue">Destaques 2026 / 2027</span>
          <h2 class="section-title">Viagens mais procuradas</h2>
          <p class="section-subtitle">
            Garanta sua vaga com antecedência. Clique em qualquer roteiro para ver os detalhes, compartilhar com a família ou reservar no WhatsApp.
          </p>
        </div>
        <a href="/calendario" class="btn btn-outline">Ver todas as {TRIPS.length} saídas →</a>
      </div>

      <div class="grid-3">
        {featuredTrips.map((trip) => (
          <TripCard trip={trip} showSectorBadge={true} />
        ))}
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <HowItWorks />

  <!-- PROVA SOCIAL & CONFIANÇA -->
  <TrustSection />

  <!-- BANNER GRUPOS FECHADOS -->
  <section class="section">
    <div class="container">
      <div class="cta-box">
        <div>
          <span class="hero-eyebrow-light">Grupos Fechados • Paróquias • Melhor Idade • Empresas</span>
          <h2>Quer montar uma excursão exclusiva para o seu grupo?</h2>
          <p>
            Organizamos roteiros personalizados para romarias, associações, famílias, escolas e eventos saindo de Fortaleza.
          </p>
        </div>
        <div class="cta-box-actions">
          <a href={groupWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
            Solicitar orçamento no WhatsApp
          </a>
          <a href="/sobre" class="btn btn-outline-light">
            Conhecer nossa história
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    background: linear-gradient(135deg, #0b2942 0%, #0e4a73 52%, #1b7fc1 100%);
    color: #ffffff;
    padding: 4.25rem 0 5.75rem;
    position: relative;
    overflow: hidden;
  }

  .home-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.16;
    pointer-events: none;
    z-index: 0;
  }

  .home-hero::before {
    content: '';
    position: absolute;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(217, 30, 42, 0.28) 0%, transparent 70%);
    top: -160px;
    right: -120px;
    pointer-events: none;
    z-index: 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr;
    gap: 2.75rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.28);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1.2rem;
  }

  .hero-copy h1 {
    color: #ffffff;
    font-size: clamp(2.1rem, 4.2vw, 3.2rem);
    font-weight: 800;
    line-height: 1.12;
    margin-bottom: 1.1rem;
  }

  .hero-copy .highlight {
    color: #ffd1d4;
  }

  .hero-copy p {
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.1rem;
    max-width: 600px;
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .hero-trust strong {
    display: block;
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    font-size: 1.45rem;
    font-weight: 800;
    color: #ffffff;
  }

  .hero-trust span {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .hero-panel-card {
    background: #ffffff;
    color: var(--sb-text);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-lg);
  }

  .panel-label {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sb-red);
    background: var(--sb-red-soft);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  .hero-panel-card h2 {
    font-size: 1.55rem;
    margin-bottom: 0.4rem;
  }

  .hero-panel-card > p {
    font-size: 0.94rem;
    margin-bottom: 1.2rem;
  }

  .hero-mini-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
  }

  .hero-mini-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--sb-blue);
    margin-top: 7px;
    flex-shrink: 0;
  }

  .dot-red {
    background: var(--sb-red);
  }

  .hero-mini-list strong {
    display: block;
    font-size: 0.94rem;
    color: var(--sb-blue-deep);
  }

  .hero-mini-list span {
    display: block;
    font-size: 0.86rem;
    color: var(--sb-muted);
    line-height: 1.45;
  }

  .panel-btn {
    width: 100%;
  }

  /* Barra de busca rápida */
  .quick-search-wrap {
    margin-top: -2.4rem;
    position: relative;
    z-index: 10;
  }

  .quick-search-bar {
    background: #ffffff;
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-lg);
    padding: 1.15rem 1.35rem;
    box-shadow: var(--shadow-lg);
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 1rem;
    align-items: end;
  }

  .qs-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .qs-field label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sb-blue-dark);
  }

  .qs-field select {
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--sb-blue-deep);
    background: var(--sb-bg);
    border: 1px solid var(--sb-border);
    border-radius: 12px;
    padding: 0.78rem 1rem;
    cursor: pointer;
  }

  .qs-submit {
    padding: 0.85rem 1.65rem;
    white-space: nowrap;
  }

  /* Setores */
  .sector-card {
    background: var(--sb-surface);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .sector-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--sb-blue);
  }

  .sector-card-top {
    position: relative;
    padding: 1.45rem 1.35rem;
    color: #ffffff;
    min-height: 155px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  .sector-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
    z-index: 0;
  }

  .sector-card:hover .sector-card-img {
    transform: scale(1.06);
  }

  .sector-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 41, 66, 0.48) 0%, rgba(11, 41, 66, 0.82) 100%);
    z-index: 1;
  }

  .sector-count,
  .sector-card-top h3 {
    position: relative;
    z-index: 2;
  }

  .sector-count {
    align-self: flex-start;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(4px);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  .sector-card-top h3 {
    color: #ffffff;
    font-size: 1.24rem;
    font-weight: 800;
    margin: 0.8rem 0 0;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  }

  .sector-card-body {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .sector-eyebrow {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--sb-blue);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.45rem;
  }

  .sector-card-body p {
    font-size: 0.92rem;
    flex: 1;
  }

  .sector-cta {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--sb-red);
    margin-top: 0.5rem;
  }

  .section-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
  }

  .section-header-row .section-subtitle {
    margin-bottom: 0;
    max-width: 620px;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .quick-search-bar {
      grid-template-columns: 1fr;
    }
  }
</style>
