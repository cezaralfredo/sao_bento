---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import StampBadge from '../components/StampBadge.astro';
import { COMPANY, FAQ_ITEMS, getWhatsAppUrl } from '../data/viagens';

const mapsDirectionsUrl =
  'https://www.google.com/maps/search/?api=1&query=Rua+Coronel+Olegario+Memoria,+2495,+Fortaleza+-+CE';
---

<BaseLayout
  title="Sobre a São Bento Turismo | História, Contato e Dúvidas Frequentes"
  description="Conheça a história da São Bento Turismo em Fortaleza (CE), fundada em 2006. Veja endereço, CNPJ, telefones oficiais de WhatsApp e perguntas frequentes."
  currentPath="/sobre"
  ogImage="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1200&q=80"
>
  <section class="sector-hero" style="background: linear-gradient(135deg, #092338 0%, #0E4A73 60%, #1268A3 100%);">
    <img
      src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1400&q=80"
      alt=""
      class="sector-hero-bg"
      aria-hidden="true"
      onerror="this.style.display='none'"
    />
    <div class="container">
      <span class="hero-eyebrow-light">✦ Nossa História • Fortaleza, Ceará</span>
      <h1>
        20 anos formando grupos e realizando <span class="h1-accent">viagens inesquecíveis</span>
      </h1>
      <p>
        Fundada em 29 de agosto de 2006 por {COMPANY.founders}, a {COMPANY.legalName} une tradição familiar, organização e atendimento próximo em cada roteiro.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container story-grid">
      <div>
        <span class="eyebrow">Quem Somos</span>
        <blockquote class="story-quote">
          “{COMPANY.historicalSlogan}”
        </blockquote>
        <p>
          Desde o início das nossas atividades em Fortaleza, a <strong>{COMPANY.brandName}</strong> nasceu com um propósito claro: oferecer viagens bem organizadas, seguras e acessíveis, com foco especial na <strong>formação de grupos</strong>.
        </p>
        <p>
          Ao longo dessas duas décadas, construímos uma trajetória sólida atendendo famílias, amigos, comunidades paroquiais e grupos da <strong>Melhor Idade (60+)</strong> — tanto em passeios pelo litoral e serra do Ceará quanto em grandes excursões rodoviárias pelo Nordeste, peregrinações religiosas e viagens aéreas nacionais e internacionais.
        </p>
        <p>
          Hoje, continuamos com o mesmo cuidado artesanal no atendimento: conversa direta pelo WhatsApp, transparência nas condições e acompanhamento próximo para que cada passageiro saiba exatamente o que esperar antes de embarcar.
        </p>
      </div>

      <div class="facts-card">
        <div class="facts-stamp">
          <StampBadge size={94} variant="navy" />
        </div>
        <h3>Dados Oficiais da Agência</h3>
        <dl class="facts-list">
          <div>
            <dt>Razão Social</dt>
            <dd>{COMPANY.legalName}</dd>
          </div>
          <div>
            <dt>CNPJ</dt>
            <dd>{COMPANY.cnpj} (Ativa desde 29/08/2006)</dd>
          </div>
          <div>
            <dt>Atuação</dt>
            <dd>Agência de Viagens, Operadora Turística e Formação de Grupos</dd>
          </div>
          <div>
            <dt>Endereço em Fortaleza</dt>
            <dd>{COMPANY.address} • CEP {COMPANY.cep}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- CONTATO E LOCALIZAÇÃO -->
  <section class="section section-alt" id="contato">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow eyebrow-blue">Atendimento & Localização</span>
        <h2 class="section-title">
          Fale direto com a <span class="h2-serif">nossa equipe</span>
        </h2>
        <p class="section-subtitle">
          Escolha um dos nossos canais oficiais de WhatsApp para consultar roteiros, valores e vagas disponíveis.
        </p>
      </div>

      <div class="contact-grid">
        <div class="contact-cards">
          {COMPANY.phones.map((phone, idx) => (
            <div class="contact-item">
              <span class="contact-label">{phone.label}</span>
              <h3>{phone.display}</h3>
              <p>Atendimento para reservas, envio de roteiros, dúvidas de embarque e grupos fechados.</p>
              <a
                href={getWhatsAppUrl('Olá, São Bento Turismo! Vim pela página de contato do site e gostaria de informações.', idx as 0 | 1)}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-whatsapp"
              >
                <WhatsAppIcon size={18} />
                Iniciar conversa no WhatsApp
              </a>
            </div>
          ))}
        </div>

        <div class="map-card">
          <iframe
            title="Localização da São Bento Turismo em Fortaleza - CE"
            src="https://www.google.com/maps?q=Rua+Coronel+Olegario+Memoria,+2495,+Fortaleza+-+CE&output=embed"
            width="100%"
            height="100%"
            style="border:0; min-height: 340px;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <div class="map-footer">
            <span>{COMPANY.address}</span>
            <a href={mapsDirectionsUrl} target="_blank" rel="noopener noreferrer" class="map-link">
              Abrir no Google Maps →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="duvidas">
    <div class="container">
      <div class="section-header center">
        <span class="eyebrow">Perguntas Frequentes</span>
        <h2 class="section-title">
          Dúvidas comuns <span class="h2-serif">antes de reservar</span>
        </h2>
      </div>

      <FaqAccordion items={FAQ_ITEMS} />
    </div>
  </section>
</BaseLayout>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.95fr;
    gap: 2.75rem;
    align-items: start;
  }

  .story-quote {
    margin: 0 0 1.4rem;
    padding: 0.35rem 0 0.35rem 1.25rem;
    border-left: 4px solid var(--sb-red);
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.85rem, 3.2vw, 2.55rem);
    line-height: 1.15;
    color: var(--sb-blue-deep);
  }

  .facts-card {
    position: relative;
    background: var(--sb-surface);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .facts-stamp {
    position: absolute;
    top: -1.4rem;
    right: 1.25rem;
  }

  .facts-card h3 {
    font-size: 1.26rem;
    margin-bottom: 1.25rem;
    padding-right: 5.5rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--sb-border);
  }

  .facts-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
  }

  .facts-list dt {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--sb-blue-action);
    margin-bottom: 0.2rem;
  }

  .facts-list dd {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--sb-blue-deep);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 1.75rem;
    align-items: stretch;
  }

  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-item {
    background: var(--sb-surface);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-md);
    padding: 1.55rem;
    box-shadow: var(--shadow-sm);
  }

  .contact-label {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sb-red-dark);
  }

  .contact-item h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin: 0.3rem 0 0.5rem;
  }

  .contact-item p {
    font-size: 0.95rem;
    margin-bottom: 1.1rem;
  }

  .map-card {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--sb-border);
    box-shadow: var(--shadow-sm);
    background: #ffffff;
    display: flex;
    flex-direction: column;
  }

  .map-card iframe {
    flex: 1;
  }

  .map-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.95rem 1.25rem;
    border-top: 1px solid var(--sb-border);
    background: var(--sb-bg);
    font-size: 0.88rem;
    color: var(--sb-muted);
  }

  .map-link {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--sb-blue-action);
    white-space: nowrap;
  }

  .map-link:hover {
    color: var(--sb-blue-dark);
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .story-grid,
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .facts-stamp {
      position: static;
      margin-bottom: 1rem;
    }

    .facts-card h3 {
      padding-right: 0;
    }
  }
</style>
