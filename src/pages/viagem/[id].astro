---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripCard from '../../components/TripCard.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import {
  COMPANY,
  FAQ_ITEMS,
  HOW_IT_WORKS_STEPS,
  SECTORS,
  TRIPS,
  getTripShareUrl,
  getTripWhatsAppUrl,
  type Trip,
} from '../../data/viagens';

export function getStaticPaths() {
  return TRIPS.map((trip) => ({
    params: { id: trip.id },
    props: { trip },
  }));
}

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;
const sector = SECTORS[trip.sector];
const waPrimary = getTripWhatsAppUrl(trip, 0);
const waSecondary = getTripWhatsAppUrl(trip, 1);
const shareUrl = getTripShareUrl(trip);

const relatedTrips = TRIPS.filter(
  (t) => t.sector === trip.sector && t.id !== trip.id
).slice(0, 3);
const relatedGridClass = relatedTrips.length <= 2 ? 'grid-2' : 'grid-3';
---

<BaseLayout
  title={`${trip.title} (${trip.dates}) | São Bento Turismo — Fortaleza`}
  description={`${trip.summary} Saída de Fortaleza com a São Bento Turismo em ${trip.dates} (${trip.month}).`}
  currentPath={`/${sector.slug}`}
  ogImage={trip.image}
  ogType="article"
  hideFloatingWaOnMobile={true}
>
  <section class="trip-hero" style={`background: ${trip.gradient};`}>
    <img
      src={trip.image}
      alt={trip.title}
      class="trip-hero-img"
      onerror="this.style.display='none'"
    />
    <div class="trip-hero-overlay"></div>

    <div class="container trip-hero-inner">
      <nav class="breadcrumb" aria-label="Caminho de navegação">
        <a href="/">Início</a>
        <span aria-hidden="true">/</span>
        <a href={`/${sector.slug}`}>{sector.title}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{trip.cardTitle ?? trip.title}</span>
      </nav>

      <div class="trip-hero-badges">
        <span class="hero-pill">{trip.modality} • {trip.destinationState}</span>
        <span class="hero-pill">{trip.duration}</span>
        {trip.tag && <span class="hero-pill hero-pill-accent">{trip.tag}</span>}
      </div>

      <h1>{trip.title}</h1>
      <p class="trip-hero-date">
        <strong>{trip.dates}</strong> • {trip.month} • Saída de Fortaleza (CE)
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container detail-grid">
      <!-- COLUNA PRINCIPAL -->
      <div class="detail-main">
        <div class="detail-block">
          <span class="eyebrow eyebrow-blue">Sobre este roteiro</span>
          <h2>O que esperar desta viagem</h2>
          <p class="lead-text">{trip.summary}</p>

          <div class="highlights-box">
            <h3>Destaques da programação</h3>
            <ul class="detail-check-list">
              {trip.highlights.map((item) => (
                <li>
                  <span class="check-dot" aria-hidden="true">✓</span>
                  <span>{item}</span>
                </li>
              ))}
              <li>
                <span class="check-dot" aria-hidden="true">✓</span>
                <span>Embarque organizado saindo de Fortaleza (CE)</span>
              </li>
              <li>
                <span class="check-dot" aria-hidden="true">✓</span>
                <span>Acompanhamento de grupo e suporte direto da equipe São Bento Turismo</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="detail-block">
          <span class="eyebrow">Transparência antes de reservar</span>
          <h2>O que enviamos na ficha do roteiro</h2>
          <p>
            Para que você decida com total segurança e sem surpresas, ao clicar no WhatsApp enviamos a ficha atualizada desta saída contendo:
          </p>
          <div class="info-cards">
            <div class="info-mini">
              <strong>Valores e parcelamento</strong>
              <span>Tarifas vigentes por pessoa e formas de pagamento aceitas.</span>
            </div>
            <div class="info-mini">
              <strong>Inclusões e exclusões</strong>
              <span>Detalhamento claro de transporte, hospedagem, passeios e refeições.</span>
            </div>
            <div class="info-mini">
              <strong>Embarque e horários</strong>
              <span>Ponto de saída em Fortaleza, horário previsto e orientações pré-viagem.</span>
            </div>
            <div class="info-mini">
              <strong>Regras de reserva</strong>
              <span>Condições de confirmação de vaga, remarcação e cancelamento.</span>
            </div>
          </div>
        </div>

        <div class="detail-block">
          <span class="eyebrow eyebrow-blue">Passo a passo</span>
          <h2>Como reservar sua vaga</h2>
          <div class="mini-steps">
            {HOW_IT_WORKS_STEPS.map((s) => (
              <div class="mini-step">
                <span class="mini-step-num">{s.step}</span>
                <div>
                  <strong>{s.title}</strong>
                  <p>{s.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="detail-block">
          <h2>Dúvidas frequentes</h2>
          <FaqAccordion items={FAQ_ITEMS.slice(0, 3)} compact={true} />
        </div>
      </div>

      <!-- SIDEBAR STICKY DE RESERVA -->
      <aside class="detail-sidebar">
        <div class="booking-card">
          <span class="booking-label">Saída programada</span>
          <h3>{trip.dates}</h3>
          <p class="booking-meta">
            {trip.month} • {trip.duration} • {trip.modality}
          </p>

          <div class="booking-facts">
            <div>
              <span>Origem</span>
              <strong>Fortaleza - CE</strong>
            </div>
            <div>
              <span>Setor</span>
              <strong>{sector.shortTitle}</strong>
            </div>
            <div>
              <span>Valores</span>
              <strong>Sob consulta</strong>
            </div>
            <div>
              <span>Atendimento</span>
              <strong>Direto no WhatsApp</strong>
            </div>
          </div>

          <a
            href={waPrimary}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp booking-btn"
          >
            <WhatsAppIcon size={18} />
            Consultar valores e vagas
          </a>
          <p class="booking-phone-hint">Atendimento principal: {COMPANY.phones[0].display}</p>

          <a
            href={waSecondary}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline booking-btn booking-btn-alt"
          >
            <WhatsAppIcon size={16} />
            WhatsApp 2 • {COMPANY.phones[1].display}
          </a>

          <hr class="booking-divider" />

          <a
            href={shareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="share-banner-btn"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <circle cx="18" cy="5" r="3" />
              <circle cx="6" cy="12" r="3" />
              <circle cx="18" cy="19" r="3" />
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
            </svg>
            Enviar este roteiro para família ou amigos
          </a>

          <p class="booking-trust">
            <strong>{COMPANY.brandName}</strong> • CNPJ {COMPANY.cnpj} • Desde {COMPANY.foundedYear} em Fortaleza.
          </p>
        </div>
      </aside>
    </div>
  </section>

  {relatedTrips.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Continue explorando</span>
          <h2 class="section-title">Outros roteiros em {sector.title}</h2>
        </div>
        <div class={relatedGridClass}>
          {relatedTrips.map((rel) => (
            <TripCard trip={rel} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- BARRA FIXA DE CONVERSÃO NO MOBILE -->
  <div class="mobile-sticky-cta">
    <div class="mobile-sticky-info">
      <strong>{trip.dates}</strong>
      <span>{trip.month} • {trip.duration}</span>
    </div>
    <a href={waPrimary} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp mobile-sticky-btn">
      <WhatsAppIcon size={17} />
      Consultar no WhatsApp
    </a>
  </div>
</BaseLayout>

<style>
  .trip-hero {
    position: relative;
    color: #ffffff;
    padding: 3.5rem 0 4rem;
    overflow: hidden;
  }

  .trip-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .trip-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(11, 41, 66, 0.88) 0%, rgba(14, 74, 115, 0.72) 55%, rgba(11, 41, 66, 0.84) 100%);
    z-index: 1;
  }

  .trip-hero-inner {
    position: relative;
    z-index: 2;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 1.25rem;
  }

  .breadcrumb a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .trip-hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .hero-pill {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.34);
    backdrop-filter: blur(4px);
    padding: 0.32rem 0.82rem;
    border-radius: 999px;
  }

  .hero-pill-accent {
    background: var(--sb-red);
    border-color: var(--sb-red);
  }

  .trip-hero h1 {
    color: #ffffff;
    font-size: clamp(1.9rem, 3.8vw, 2.85rem);
    max-width: 820px;
    margin-bottom: 0.65rem;
  }

  .trip-hero-date {
    color: rgba(255, 255, 255, 0.94);
    font-size: 1.08rem;
    margin: 0;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: 2.5rem;
    align-items: start;
  }

  .detail-main {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .detail-block h2 {
    font-size: 1.55rem;
    margin-bottom: 0.85rem;
  }

  .lead-text {
    font-size: 1.08rem;
    color: var(--sb-text);
    line-height: 1.7;
  }

  .highlights-box {
    background: var(--sb-surface);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.65rem;
    margin-top: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .highlights-box h3 {
    font-size: 1.1rem;
    margin-bottom: 0.9rem;
  }

  .detail-check-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .detail-check-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.98rem;
    color: var(--sb-text);
  }

  .check-dot {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--sb-blue-soft);
    color: var(--sb-blue-action);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 0.82rem;
    margin-top: 2px;
  }

  .info-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .info-mini {
    background: var(--sb-surface);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-md);
    padding: 1.15rem 1.25rem;
  }

  .info-mini strong {
    display: block;
    color: var(--sb-blue-deep);
    font-size: 0.98rem;
    margin-bottom: 0.25rem;
  }

  .info-mini span {
    font-size: 0.92rem;
    color: var(--sb-muted);
  }

  .mini-steps {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .mini-step {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: var(--sb-surface);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-md);
    padding: 1.15rem 1.25rem;
  }

  .mini-step-num {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--sb-blue-soft);
    color: var(--sb-blue-dark);
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    font-weight: 800;
    display: grid;
    place-items: center;
  }

  .mini-step strong {
    display: block;
    color: var(--sb-blue-deep);
    margin-bottom: 0.2rem;
  }

  .mini-step p {
    margin: 0;
    font-size: 0.94rem;
  }

  /* Sidebar */
  .detail-sidebar {
    position: sticky;
    top: 96px;
  }

  .booking-card {
    background: var(--sb-surface);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-md);
  }

  .booking-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--sb-red-dark);
    background: var(--sb-red-soft);
    padding: 0.3rem 0.78rem;
    border-radius: 999px;
    margin-bottom: 0.65rem;
  }

  .booking-card h3 {
    font-size: 1.45rem;
    margin-bottom: 0.25rem;
  }

  .booking-meta {
    font-size: 0.95rem;
    margin-bottom: 1.2rem;
  }

  .booking-facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
    background: var(--sb-bg);
    border-radius: 12px;
    padding: 1rem 1.1rem;
    margin-bottom: 1.25rem;
  }

  .booking-facts > div {
    display: flex;
    justify-content: space-between;
    font-size: 0.92rem;
  }

  .booking-facts span {
    color: var(--sb-muted);
  }

  .booking-facts strong {
    color: var(--sb-blue-deep);
  }

  .booking-btn {
    width: 100%;
    font-size: 0.95rem;
  }

  .booking-phone-hint {
    font-size: 0.84rem;
    color: var(--sb-muted);
    text-align: center;
    margin: 0.45rem 0 0.85rem;
  }

  .booking-btn-alt {
    font-size: 0.9rem;
    padding: 0.72rem 1rem;
  }

  .booking-divider {
    border: 0;
    border-top: 1px solid var(--sb-border);
    margin: 1.1rem 0;
  }

  .share-banner-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    background: var(--sb-blue-soft);
    color: var(--sb-blue-dark);
    font-weight: 700;
    font-size: 0.9rem;
    transition: background 0.15s ease;
  }

  .share-banner-btn:hover {
    background: #d8ecf9;
  }

  .booking-trust {
    font-size: 0.84rem;
    color: var(--sb-muted);
    text-align: center;
    margin: 1rem 0 0;
  }

  .mobile-sticky-cta {
    display: none;
  }

  @media (max-width: 960px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }

    .detail-sidebar {
      position: static;
    }

    .info-cards {
      grid-template-columns: 1fr;
    }

    .mobile-sticky-cta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.85rem;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 70;
      background: #ffffff;
      border-top: 1px solid var(--sb-border);
      padding: 0.75rem 1rem;
      box-shadow: 0 -6px 20px rgba(11, 41, 66, 0.14);
    }

    .mobile-sticky-info strong {
      display: block;
      font-size: 0.94rem;
      color: var(--sb-blue-deep);
    }

    .mobile-sticky-info span {
      font-size: 0.82rem;
      color: var(--sb-muted);
    }

    .mobile-sticky-btn {
      padding: 0.7rem 1.1rem;
      font-size: 0.9rem;
      white-space: nowrap;
    }
  }
</style>
