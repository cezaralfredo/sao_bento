---
import '../styles/global.css';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { COMPANY, SECTOR_LIST, getWhatsAppUrl } from '../data/viagens';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  hideFloatingWaOnMobile?: boolean;
}

const {
  title,
  description,
  currentPath = '/',
  ogImage = 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80',
  ogType = 'website',
  hideFloatingWaOnMobile = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, COMPANY.siteUrl).toString();
const resolvedOgImage = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, COMPANY.siteUrl).toString();

const defaultWaUrl = getWhatsAppUrl(
  'Olá, São Bento Turismo! Vim pelo site e gostaria de saber mais sobre as próximas viagens e valores.'
);

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/passeios-ceara', label: 'Passeios CE' },
  { href: '/excursoes-nordeste', label: 'Nordeste' },
  { href: '/turismo-religioso', label: 'Religioso' },
  { href: '/viagens-especiais', label: 'Especiais & Aéreo' },
  { href: '/calendario', label: 'Calendário' },
  { href: '/sobre', label: 'Sobre' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/images/logo-sao-bento.png" />

    <!-- Open Graph / WhatsApp / Redes Sociais -->
    <meta property="og:site_name" content={COMPANY.brandName} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=Cormorant+Garamond:ital,wght@0,600;1,600;1,700&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;0,9..144,800;1,9..144,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={[{ 'has-mobile-sticky-cta': hideFloatingWaOnMobile }]}>
    <a href="#conteudo-principal" class="skip-link">Pular para o conteúdo principal</a>

    <div class="topbar">
      <div class="container topbar-inner">
        <span>Saídas organizadas de <strong>Fortaleza - CE</strong> • Desde {COMPANY.foundedYear}</span>
        <div class="topbar-phones">
          <a href={getWhatsAppUrl('Olá! Vim pelo site da São Bento Turismo.', 0)} target="_blank" rel="noopener noreferrer">
            WhatsApp: {COMPANY.phones[0].display}
          </a>
          <span aria-hidden="true">•</span>
          <a href={getWhatsAppUrl('Olá! Vim pelo site da São Bento Turismo.', 1)} target="_blank" rel="noopener noreferrer">
            {COMPANY.phones[1].display}
          </a>
        </div>
      </div>
    </div>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="São Bento Turismo - Página Inicial">
          <img src="/images/logo-sao-bento.png" alt="Logo São Bento Turismo" width="170" height="72" />
        </a>

        <button
          class="menu-toggle"
          id="menu-toggle"
          type="button"
          aria-label="Abrir menu de navegação"
          aria-expanded="false"
          aria-controls="main-nav"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

        <nav class="main-nav" id="main-nav" aria-label="Navegação principal">
          {navLinks.map((link) => {
            const isActive = currentPath === link.href;
            return (
              <a
                href={link.href}
                class:list={['nav-link', { active: isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            );
          })}
          <a
            href={defaultWaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp nav-cta"
          >
            <WhatsAppIcon size={16} />
            Reservar no WhatsApp
          </a>
        </nav>
      </div>
    </header>

    <main id="conteudo-principal">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <div class="footer-logo-wrap">
            <img src="/images/logo-sao-bento.png" alt="Logo São Bento Turismo" width="160" height="68" />
          </div>
          <p class="footer-tagline">
            {COMPANY.slogan}. Há 20 anos formando grupos de viagens saindo de Fortaleza com organização, alegria e acompanhamento próximo.
          </p>
          <p class="footer-legal">
            <strong>{COMPANY.legalName}</strong><br />
            CNPJ: {COMPANY.cnpj}<br />
            {COMPANY.address} • CEP {COMPANY.cep}
          </p>
        </div>

        <div>
          <h4>Setores de Turismo</h4>
          <ul class="footer-links">
            {SECTOR_LIST.map((sector) => (
              <li><a href={`/${sector.slug}`}>{sector.title}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <h4>Navegação</h4>
          <ul class="footer-links">
            <li><a href="/">Página Inicial</a></li>
            <li><a href="/calendario">Calendário 2026 / 2027</a></li>
            <li><a href="/sobre">Nossa História & FAQ</a></li>
            <li><a href="/sobre#contato">Localização & Contato</a></li>
          </ul>
        </div>

        <div>
          <h4>Atendimento Direto</h4>
          <p class="footer-contact-note">
            Clique abaixo para receber valores, roteiro detalhado e garantir sua vaga:
          </p>
          <div class="footer-wa-list">
            {COMPANY.phones.map((phone, index) => (
              <a
                href={getWhatsAppUrl('Olá, São Bento Turismo! Gostaria de receber informações sobre as próximas excursões.', index as 0 | 1)}
                target="_blank"
                rel="noopener noreferrer"
                class="footer-wa-btn"
              >
                <span class="footer-wa-label">
                  <WhatsAppIcon size={16} />
                  WhatsApp:
                </span>
                <strong>{phone.display}</strong>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <div class="container footer-bottom-inner">
          <span>© {new Date().getFullYear()} {COMPANY.brandName} — Todos os direitos reservados.</span>
          <span>Fortaleza, Ceará • Desde {COMPANY.foundedYear}</span>
        </div>
      </div>
    </footer>

    <a
      href={defaultWaUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="wa-float"
      aria-label="Falar com a São Bento Turismo no WhatsApp"
    >
      <WhatsAppIcon size={24} />
      <span>WhatsApp</span>
    </a>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const nav = document.getElementById('main-nav');

      function closeMenu() {
        if (!toggle || !nav) return;
        nav.classList.remove('open');
        toggle.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menu de navegação');
      }

      if (toggle && nav) {
        toggle.addEventListener('click', (event) => {
          event.stopPropagation();
          const isOpen = nav.classList.toggle('open');
          toggle.classList.toggle('open', isOpen);
          toggle.setAttribute('aria-expanded', String(isOpen));
          toggle.setAttribute('aria-label', isOpen ? 'Fechar menu de navegação' : 'Abrir menu de navegação');
        });

        nav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', closeMenu);
        });

        document.addEventListener('click', (event) => {
          const target = event.target as Node | null;
          if (nav.classList.contains('open') && target && !nav.contains(target) && !toggle.contains(target)) {
            closeMenu();
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && nav.classList.contains('open')) {
            closeMenu();
            toggle.focus();
          }
        });
      }
    </script>
  </body>
</html>

<style>
  .topbar {
    background: var(--sb-blue-deep);
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.86rem;
    padding: 0.5rem 0;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .topbar-phones {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
  }

  .topbar-phones a:hover {
    color: var(--sb-warm-light);
    text-decoration: underline;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 247, 242, 0.94);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--sb-border);
    box-shadow: 0 2px 14px rgba(9, 35, 56, 0.05);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.55rem;
    padding-bottom: 0.55rem;
  }

  .brand {
    flex-shrink: 0;
  }

  .brand img {
    height: 54px;
    width: auto;
    object-fit: contain;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    font-size: 0.91rem;
    font-weight: 600;
    color: var(--sb-blue-deep);
    padding: 0.48rem 0.72rem;
    border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    background: var(--sb-blue-soft);
    color: var(--sb-blue-dark);
  }

  .nav-link.active {
    background: var(--sb-blue-action);
    color: #ffffff;
  }

  .nav-cta {
    margin-left: 0.45rem;
    padding: 0.6rem 1.05rem;
    font-size: 0.88rem;
    white-space: nowrap;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    border: 1px solid var(--sb-border);
    border-radius: 10px;
    background: #ffffff;
    cursor: pointer;
    padding: 9px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .menu-toggle:hover {
    border-color: var(--sb-blue-action);
    background: var(--sb-blue-soft);
  }

  .menu-toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--sb-blue-deep);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
    transform-origin: center;
  }

  .menu-toggle.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle.open span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Footer */
  .site-footer {
    background: var(--sb-blue-deep);
    color: rgba(255, 255, 255, 0.9);
    padding-top: 4rem;
    margin-top: 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 0.9fr 1.2fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer-logo-wrap {
    display: inline-block;
    background: #ffffff;
    padding: 0.55rem 0.95rem;
    border-radius: 12px;
    margin-bottom: 1rem;
  }

  .footer-logo-wrap img {
    height: 48px;
    width: auto;
  }

  .footer-tagline {
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.95rem;
  }

  .footer-legal {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 0;
    line-height: 1.6;
  }

  .site-footer h4 {
    color: #ffffff;
    font-size: 1.02rem;
    margin-bottom: 1rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.95rem;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .footer-contact-note {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.84);
    margin-bottom: 0.9rem;
  }

  .footer-wa-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
    padding: 0.72rem 1rem;
    font-size: 0.94rem;
    color: #ffffff;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .footer-wa-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .footer-wa-btn:hover {
    background: var(--sb-wa);
    border-color: var(--sb-wa);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    padding: 1.25rem 0;
    font-size: 0.86rem;
    color: rgba(255, 255, 255, 0.78);
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* WhatsApp flutuante */
  .wa-float {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--sb-wa);
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.76rem 1.1rem;
    border-radius: 999px;
    box-shadow: 0 10px 24px rgba(17, 96, 46, 0.36);
    transition: transform 0.16s ease, background 0.16s ease;
  }

  .wa-float:hover {
    transform: translateY(-3px);
    background: var(--sb-wa-dark);
  }

  @media (max-width: 1140px) {
    .menu-toggle {
      display: flex;
    }

    .main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #ffffff;
      border-bottom: 1px solid var(--sb-border);
      box-shadow: var(--shadow-md);
      flex-direction: column;
      align-items: stretch;
      padding: 1rem 1.25rem 1.35rem;
      gap: 0.4rem;
    }

    .main-nav.open {
      display: flex;
    }

    .nav-link {
      padding: 0.68rem 1rem;
      font-size: 0.98rem;
    }

    .nav-cta {
      margin-left: 0;
      margin-top: 0.5rem;
      padding: 0.8rem 1.25rem;
      font-size: 0.95rem;
    }

    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .wa-float span {
      display: none;
    }

    .wa-float {
      padding: 0.88rem;
    }
  }

  @media (max-width: 960px) {
    /* Evita colisão entre o botão flutuante e a barra fixa da página de viagem */
    body.has-mobile-sticky-cta .wa-float {
      display: none;
    }

    body.has-mobile-sticky-cta .site-footer {
      padding-bottom: 5.5rem;
    }
  }

  @media (max-width: 640px) {
    .topbar-inner {
      justify-content: center;
      text-align: center;
    }

    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
