---
import '../styles/global.css';
import { COMPANY, SECTOR_LIST, getWhatsAppUrl } from '../data/viagens';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
}

const { title, description, currentPath = '/' } = Astro.props;
const defaultWaUrl = getWhatsAppUrl(
  'Olá, São Bento Turismo! Vim pelo site e gostaria de saber mais sobre as próximas viagens e valores.'
);

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/passeios-ceara', label: 'Passeios CE' },
  { href: '/excursoes-nordeste', label: 'Nordeste' },
  { href: '/turismo-religioso', label: 'Religioso' },
  { href: '/viagens-especiais', label: 'Especiais & Aéreo' },
  { href: '/calendario', label: 'Calendário' },
  { href: '/sobre', label: 'Sobre' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/logo-sao-bento.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="topbar">
      <div class="container topbar-inner">
        <span>Saídas organizadas de <strong>Fortaleza - CE</strong> • Desde {COMPANY.foundedYear}</span>
        <div class="topbar-phones">
          <a href={getWhatsAppUrl('Olá! Vim pelo site da São Bento Turismo.', 0)} target="_blank" rel="noopener noreferrer">
            WhatsApp: {COMPANY.phones[0].display}
          </a>
          <span aria-hidden="true">•</span>
          <a href={getWhatsAppUrl('Olá! Vim pelo site da São Bento Turismo.', 1)} target="_blank" rel="noopener noreferrer">
            {COMPANY.phones[1].display}
          </a>
        </div>
      </div>
    </div>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="São Bento Turismo - Página Inicial">
          <img src="/images/logo-sao-bento.png" alt="Logo São Bento Turismo" width="170" height="72" />
        </a>

        <button
          class="menu-toggle"
          id="menu-toggle"
          type="button"
          aria-label="Abrir menu de navegação"
          aria-expanded="false"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

        <nav class="main-nav" id="main-nav" aria-label="Navegação principal">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={['nav-link', { active: currentPath === link.href }]}
            >
              {link.label}
            </a>
          ))}
          <a
            href={defaultWaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp nav-cta"
          >
            Reservar no WhatsApp
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <div class="footer-logo-wrap">
            <img src="/images/logo-sao-bento.png" alt="Logo São Bento Turismo" width="160" height="68" />
          </div>
          <p class="footer-tagline">
            {COMPANY.slogan}. Há 20 anos formando grupos de viagens saindo de Fortaleza com organização, alegria e acompanhamento próximo.
          </p>
          <p class="footer-legal">
            <strong>{COMPANY.legalName}</strong><br />
            CNPJ: {COMPANY.cnpj}<br />
            {COMPANY.address} • CEP {COMPANY.cep}
          </p>
        </div>

        <div>
          <h4>Setores de Turismo</h4>
          <ul class="footer-links">
            {SECTOR_LIST.map((sector) => (
              <li><a href={`/${sector.slug}`}>{sector.title}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <h4>Navegação</h4>
          <ul class="footer-links">
            <li><a href="/">Página Inicial</a></li>
            <li><a href="/calendario">Calendário 2026 / 2027</a></li>
            <li><a href="/sobre">Nossa História & FAQ</a></li>
            <li><a href="/sobre#contato">Localização & Contato</a></li>
          </ul>
        </div>

        <div>
          <h4>Atendimento Direto</h4>
          <p class="footer-contact-note">
            Clique abaixo para receber valores, roteiro detalhado e garantir sua vaga:
          </p>
          <div class="footer-wa-list">
            {COMPANY.phones.map((phone, index) => (
              <a
                href={getWhatsAppUrl('Olá, São Bento Turismo! Gostaria de receber informações sobre as próximas excursões.', index as 0 | 1)}
                target="_blank"
                rel="noopener noreferrer"
                class="footer-wa-btn"
              >
                <span>WhatsApp:</span> <strong>{phone.display}</strong>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <div class="container footer-bottom-inner">
          <span>© {new Date().getFullYear()} {COMPANY.brandName} — Todos os direitos reservados.</span>
          <span>Fortaleza, Ceará • Desde {COMPANY.foundedYear}</span>
        </div>
      </div>
    </footer>

    <a
      href={defaultWaUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="wa-float"
      aria-label="Falar com a São Bento Turismo no WhatsApp"
    >
      <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
        <path d="M12.03 2C6.5 2 2 6.48 2 12c0 1.97.57 3.81 1.56 5.36L2 22l4.79-1.52A10 10 0 0 0 12.03 22C17.56 22 22 17.52 22 12S17.56 2 12.03 2zm5.82 14.12c-.25.7-1.45 1.34-2 1.42-.52.08-1.18.11-1.9-.12-.44-.14-1-.33-1.72-.64-3.03-1.31-5.01-4.38-5.16-4.58-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.06-2.52.28-.3.61-.38.81-.38h.59c.19 0 .44-.07.69.53.25.61.86 2.1.94 2.25.08.15.13.33.03.53-.1.2-.15.33-.3.5-.15.18-.32.4-.46.53-.15.15-.31.31-.13.61.18.3.79 1.3 1.7 2.11 1.17 1.04 2.16 1.36 2.46 1.51.3.15.48.13.66-.08.18-.2.76-.88.96-1.18.2-.3.4-.25.68-.15.28.1 1.77.83 2.07.98.3.15.5.23.58.36.08.13.08.76-.17 1.46z"/>
      </svg>
      <span>WhatsApp</span>
    </a>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const nav = document.getElementById('main-nav');
      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const isOpen = nav.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(isOpen));
        });
      }
    </script>
  </body>
</html>

<style>
  .topbar {
    background: var(--sb-blue-deep);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.84rem;
    padding: 0.5rem 0;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .topbar-phones {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
  }

  .topbar-phones a:hover {
    color: #93c5fd;
    text-decoration: underline;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--sb-border);
    box-shadow: 0 2px 12px rgba(11, 41, 66, 0.05);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
  }

  .brand img {
    height: 54px;
    width: auto;
    object-fit: contain;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--sb-blue-deep);
    padding: 0.5rem 0.78rem;
    border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    background: var(--sb-blue-soft);
    color: var(--sb-blue-dark);
  }

  .nav-link.active {
    background: var(--sb-blue);
    color: #ffffff;
  }

  .nav-cta {
    margin-left: 0.5rem;
    padding: 0.62rem 1.1rem;
    font-size: 0.88rem;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    border: 1px solid var(--sb-border);
    border-radius: 10px;
    background: #ffffff;
    cursor: pointer;
    padding: 8px;
  }

  .menu-toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--sb-blue-deep);
    border-radius: 2px;
  }

  /* Footer */
  .site-footer {
    background: var(--sb-blue-deep);
    color: rgba(255, 255, 255, 0.86);
    padding-top: 4rem;
    margin-top: 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 0.9fr 1.2fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer-logo-wrap {
    display: inline-block;
    background: #ffffff;
    padding: 0.55rem 0.95rem;
    border-radius: 12px;
    margin-bottom: 1rem;
  }

  .footer-logo-wrap img {
    height: 48px;
    width: auto;
  }

  .footer-tagline {
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.94rem;
  }

  .footer-legal {
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.68);
    margin-bottom: 0;
  }

  .site-footer h4 {
    color: #ffffff;
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-links a {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.93rem;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .footer-contact-note {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 0.9rem;
  }

  .footer-wa-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    padding: 0.7rem 1rem;
    font-size: 0.92rem;
    color: #ffffff;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .footer-wa-btn:hover {
    background: var(--sb-wa);
    border-color: var(--sb-wa);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 1.25rem 0;
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.65);
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* WhatsApp flutuante */
  .wa-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: var(--sb-wa);
    color: #ffffff;
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 0.94rem;
    padding: 0.85rem 1.25rem;
    border-radius: 999px;
    box-shadow: 0 12px 28px rgba(22, 114, 55, 0.38);
    transition: transform 0.16s ease, background 0.16s ease;
  }

  .wa-float:hover {
    transform: translateY(-3px);
    background: var(--sb-wa-dark);
  }

  @media (max-width: 1080px) {
    .menu-toggle {
      display: flex;
    }

    .main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #ffffff;
      border-bottom: 1px solid var(--sb-border);
      box-shadow: var(--shadow-md);
      flex-direction: column;
      align-items: stretch;
      padding: 1rem 1.25rem 1.35rem;
      gap: 0.35rem;
    }

    .main-nav.open {
      display: flex;
    }

    .nav-cta {
      margin-left: 0;
      margin-top: 0.5rem;
    }

    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .topbar-inner {
      justify-content: center;
      text-align: center;
    }

    .footer-grid {
      grid-template-columns: 1fr;
    }

    .wa-float span {
      display: none;
    }

    .wa-float {
      padding: 0.95rem;
    }
  }
</style>
