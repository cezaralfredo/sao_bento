---
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
  compact?: boolean;
}

const { items, compact = false } = Astro.props;
---

<div class:list={['faq-list', { 'faq-list-compact': compact }]}>
  {items.map((item) => (
    <details class="faq-item">
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq-list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .faq-list-compact {
    max-width: none;
    margin: 0;
    gap: 0.75rem;
  }

  .faq-item {
    background: var(--sb-surface);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-md);
    padding: 1.15rem 1.4rem;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }

  .faq-item:hover {
    border-color: #cbd5e1;
  }

  .faq-item[open] {
    border-color: var(--sb-blue);
    box-shadow: var(--shadow-md);
  }

  .faq-item summary {
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--sb-blue-deep);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    line-height: 1.4;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--sb-blue-soft);
    color: var(--sb-blue-action);
    display: grid;
    place-items: center;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
    transition: background 0.16s ease, color 0.16s ease;
  }

  .faq-item[open] summary::after {
    content: '−';
    background: var(--sb-red-soft);
    color: var(--sb-red-dark);
  }

  .faq-item p {
    margin: 0.9rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--sb-border);
    font-size: 0.96rem;
    color: var(--sb-muted);
    line-height: 1.65;
  }
</style>
