---
import {
  SECTORS,
  getTripShareUrl,
  getTripWhatsAppUrl,
  type Trip,
} from '../data/viagens';

interface Props {
  trip: Trip;
  showSectorBadge?: boolean;
}

const { trip, showSectorBadge = false } = Astro.props;
const sector = SECTORS[trip.sector];
const waUrl = getTripWhatsAppUrl(trip, 0);
const shareUrl = getTripShareUrl(trip);
const detailUrl = `/viagem/${trip.id}`;
---

<article
  class="trip-card"
  data-sector={trip.sector}
  data-month={trip.month}
>
  <a href={detailUrl} class="trip-media" style={`background: ${trip.gradient};`} aria-label={`Ver detalhes de ${trip.title}`}>
    <img
      src={trip.image}
      alt={`Destino ${trip.title}`}
      loading="lazy"
      decoding="async"
      onerror="this.style.display='none'"
    />
    <div class="trip-media-overlay"></div>

    <div class="trip-banner-top">
      <span class="trip-modality">
        {trip.modality === 'Aéreo' ? (
          <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
            <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/>
          </svg>
        ) : trip.modality === 'Bate-volta' ? (
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <rect x="3" y="4" width="18" height="12" rx="2"/>
            <path d="M3 11h18M7 16v3M17 16v3"/>
          </svg>
        )}
        {trip.modality} • {trip.destinationState}
      </span>
      {trip.tag && <span class="trip-tag">{trip.tag}</span>}
    </div>

    <div class="trip-date-box">
      <span class="trip-month">{trip.month} • {trip.duration}</span>
      <strong class="trip-dates">{trip.dates}</strong>
    </div>
  </a>

  <div class="trip-body">
    {showSectorBadge && (
      <a href={`/${sector.slug}`} class="trip-sector-link">
        {sector.shortTitle}
      </a>
    )}
    <h3 class="trip-title">
      <a href={detailUrl}>{trip.title}</a>
    </h3>
    <p class="trip-summary">{trip.summary}</p>

    <ul class="trip-highlights">
      {trip.highlights.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

    <div class="trip-footer">
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-whatsapp trip-wa-btn"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12.03 2C6.5 2 2 6.48 2 12c0 1.97.57 3.81 1.56 5.36L2 22l4.79-1.52A10 10 0 0 0 12.03 22C17.56 22 22 17.52 22 12S17.56 2 12.03 2zm5.82 14.12c-.25.7-1.45 1.34-2 1.42-.52.08-1.18.11-1.9-.12-.44-.14-1-.33-1.72-.64-3.03-1.31-5.01-4.38-5.16-4.58-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.06-2.52.28-.3.61-.38.81-.38h.59c.19 0 .44-.07.69.53.25.61.86 2.1.94 2.25.08.15.13.33.03.53-.1.2-.15.33-.3.5-.15.18-.32.4-.46.53-.15.15-.31.31-.13.61.18.3.79 1.3 1.7 2.11 1.17 1.04 2.16 1.36 2.46 1.51.3.15.48.13.66-.08.18-.2.76-.88.96-1.18.2-.3.4-.25.68-.15.28.1 1.77.83 2.07.98.3.15.5.23.58.36.08.13.08.76-.17 1.46z"/>
        </svg>
        Quero saber mais no WhatsApp
      </a>

      <div class="trip-secondary-actions">
        <a href={detailUrl} class="trip-detail-link">
          Ver página do roteiro →
        </a>
        <a
          href={shareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="trip-share-btn"
          title="Compartilhar roteiro com família e amigos no WhatsApp"
          aria-label={`Compartilhar ${trip.title} no WhatsApp`}
        >
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <circle cx="18" cy="5" r="3"/>
            <circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
          </svg>
          Indicar
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .trip-card {
    background: var(--sb-surface);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .trip-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: #cbd5e1;
  }

  .trip-media {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 16 / 10;
    min-height: 190px;
    padding: 1rem 1.15rem;
    color: #ffffff;
    overflow: hidden;
  }

  .trip-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
    z-index: 0;
  }

  .trip-card:hover .trip-media img {
    transform: scale(1.06);
  }

  .trip-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(11, 41, 66, 0.62) 0%,
      rgba(11, 41, 66, 0.18) 45%,
      rgba(11, 41, 66, 0.84) 100%
    );
    z-index: 1;
  }

  .trip-banner-top,
  .trip-date-box {
    position: relative;
    z-index: 2;
  }

  .trip-banner-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .trip-modality {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(11, 41, 66, 0.72);
    backdrop-filter: blur(4px);
    padding: 0.28rem 0.68rem;
    border-radius: 999px;
  }

  .trip-tag {
    font-size: 0.73rem;
    font-weight: 700;
    background: #ffffff;
    color: var(--sb-red);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.16);
  }

  .trip-month {
    display: block;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(255, 255, 255, 0.9);
  }

  .trip-dates {
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  }

  .trip-body {
    padding: 1.3rem 1.35rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .trip-sector-link {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sb-blue-dark);
    background: var(--sb-blue-soft);
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 0.6rem;
  }

  .trip-title {
    font-size: 1.16rem;
    font-weight: 800;
    color: var(--sb-blue-deep);
    margin-bottom: 0.55rem;
  }

  .trip-title a:hover {
    color: var(--sb-blue);
  }

  .trip-summary {
    font-size: 0.93rem;
    color: var(--sb-muted);
    margin-bottom: 1rem;
  }

  .trip-highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 1.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
  }

  .trip-highlights li {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--sb-blue-dark);
    background: #f1f5f9;
    padding: 0.28rem 0.65rem;
    border-radius: 8px;
  }

  .trip-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .trip-wa-btn {
    width: 100%;
    font-size: 0.9rem;
    padding: 0.78rem 1rem;
  }

  .trip-secondary-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  .trip-detail-link {
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--sb-blue-dark);
  }

  .trip-detail-link:hover {
    color: var(--sb-red);
    text-decoration: underline;
  }

  .trip-share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--sb-muted);
    background: #f1f5f9;
    padding: 0.32rem 0.68rem;
    border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .trip-share-btn:hover {
    background: var(--sb-blue-soft);
    color: var(--sb-blue-dark);
  }
</style>
