---
import { SECTORS, getTripWhatsAppUrl, type Trip } from '../data/viagens';

interface Props {
  trip: Trip;
  showSectorBadge?: boolean;
}

const { trip, showSectorBadge = false } = Astro.props;
const sector = SECTORS[trip.sector];
const waUrl = getTripWhatsAppUrl(trip, 0);
---

<article
  class="trip-card"
  data-sector={trip.sector}
  data-month={trip.month}
>
  <div class="trip-banner" style={`background: ${trip.gradient};`}>
    <div class="trip-banner-top">
      <span class="trip-modality">{trip.modality} • {trip.destinationState}</span>
      {trip.tag && <span class="trip-tag">{trip.tag}</span>}
    </div>
    <div class="trip-date-box">
      <span class="trip-month">{trip.month}</span>
      <strong class="trip-dates">{trip.dates}</strong>
    </div>
  </div>

  <div class="trip-body">
    {showSectorBadge && (
      <a href={`/${sector.slug}`} class="trip-sector-link">
        {sector.shortTitle}
      </a>
    )}
    <h3 class="trip-title">{trip.title}</h3>
    <p class="trip-summary">{trip.summary}</p>

    <ul class="trip-highlights">
      {trip.highlights.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

    <div class="trip-footer">
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-whatsapp trip-wa-btn"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12.03 2C6.5 2 2 6.48 2 12c0 1.97.57 3.81 1.56 5.36L2 22l4.79-1.52A10 10 0 0 0 12.03 22C17.56 22 22 17.52 22 12S17.56 2 12.03 2zm5.82 14.12c-.25.7-1.45 1.34-2 1.42-.52.08-1.18.11-1.9-.12-.44-.14-1-.33-1.72-.64-3.03-1.31-5.01-4.38-5.16-4.58-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.06-2.52.28-.3.61-.38.81-.38h.59c.19 0 .44-.07.69.53.25.61.86 2.1.94 2.25.08.15.13.33.03.53-.1.2-.15.33-.3.5-.15.18-.32.4-.46.53-.15.15-.31.31-.13.61.18.3.79 1.3 1.7 2.11 1.17 1.04 2.16 1.36 2.46 1.51.3.15.48.13.66-.08.18-.2.76-.88.96-1.18.2-.3.4-.25.68-.15.28.1 1.77.83 2.07.98.3.15.5.23.58.36.08.13.08.76-.17 1.46z"/>
        </svg>
        Quero saber mais no WhatsApp
      </a>
    </div>
  </div>
</article>

<style>
  .trip-card {
    background: var(--sb-surface);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .trip-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .trip-banner {
    padding: 1.25rem 1.35rem;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 132px;
    position: relative;
  }

  .trip-banner-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .trip-modality {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(255, 255, 255, 0.18);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  .trip-tag {
    font-size: 0.74rem;
    font-weight: 700;
    background: #ffffff;
    color: var(--sb-red);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  .trip-date-box {
    margin-top: 1.15rem;
  }

  .trip-month {
    display: block;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    opacity: 0.88;
  }

  .trip-dates {
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .trip-body {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .trip-sector-link {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sb-blue-dark);
    background: var(--sb-blue-soft);
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 0.65rem;
  }

  .trip-title {
    font-size: 1.16rem;
    font-weight: 800;
    color: var(--sb-blue-deep);
    margin-bottom: 0.55rem;
  }

  .trip-summary {
    font-size: 0.93rem;
    color: var(--sb-muted);
    margin-bottom: 1rem;
  }

  .trip-highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .trip-highlights li {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--sb-blue-dark);
    background: #f1f5f9;
    padding: 0.28rem 0.65rem;
    border-radius: 8px;
  }

  .trip-footer {
    margin-top: auto;
  }

  .trip-wa-btn {
    width: 100%;
    font-size: 0.9rem;
    padding: 0.78rem 1rem;
  }
</style>
