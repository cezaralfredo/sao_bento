---
import WhatsAppIcon from './WhatsAppIcon.astro';
import {
  SECTORS,
  getTripShareUrl,
  getTripWhatsAppUrl,
  type Trip,
} from '../data/viagens';

interface Props {
  trip: Trip;
  showSectorBadge?: boolean;
}

const { trip, showSectorBadge = false } = Astro.props;
const sector = SECTORS[trip.sector];
const waUrl = getTripWhatsAppUrl(trip, 0);
const shareUrl = getTripShareUrl(trip);
const detailUrl = `/viagem/${trip.id}`;
const displayTitle = trip.cardTitle ?? trip.title;
---

<article
  class="trip-card"
  data-sector={trip.sector}
  data-month={trip.month}
  data-modality={trip.modality}
  data-search={`${trip.title} ${trip.destinationState} ${trip.month} ${trip.modality} ${trip.tag ?? ''} ${trip.summary}`.toLowerCase()}
>
  <a
    href={detailUrl}
    class="trip-media"
    style={`background: ${trip.gradient};`}
    aria-label={`Ver detalhes de ${trip.title}`}
  >
    <img
      src={trip.image}
      alt={`Destino ${trip.title}`}
      width="900"
      height="563"
      loading="lazy"
      decoding="async"
      onerror="this.style.display='none'"
    />
    <div class="trip-media-overlay"></div>
    <div class="trip-media-frame" aria-hidden="true"></div>

    <div class="trip-banner-top">
      <span class="trip-modality">
        {trip.modality === 'Aéreo' ? (
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" />
          </svg>
        ) : trip.modality === 'Bate-volta' ? (
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <rect x="3" y="4" width="18" height="12" rx="2" />
            <path d="M3 11h18M7 16v3M17 16v3" />
          </svg>
        )}
        {trip.modality} • {trip.destinationState}
      </span>
      {trip.tag && <span class="trip-tag">{trip.tag}</span>}
    </div>

    <div class="trip-date-box">
      <span class="trip-month">{trip.month} • {trip.duration}</span>
      <strong class="trip-dates">{trip.dates}</strong>
    </div>
  </a>

  <div class="trip-body">
    {showSectorBadge && (
      <a href={`/${sector.slug}`} class="trip-sector-link">
        {sector.shortTitle}
      </a>
    )}
    <h3 class="trip-title" title={trip.title}>
      <a href={detailUrl}>{displayTitle}</a>
    </h3>
    <p class="trip-summary">{trip.summary}</p>

    <ul class="trip-highlights">
      {trip.highlights.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>

  <!-- Divisória estilo Bilhete de Embarque -->
  <div class="trip-ticket-divider" aria-hidden="true">
    <span class="ticket-notch ticket-notch-left"></span>
    <span class="ticket-line"></span>
    <span class="ticket-stamp">EMBARQUE • FORTALEZA</span>
    <span class="ticket-line"></span>
    <span class="ticket-notch ticket-notch-right"></span>
  </div>

  <div class="trip-footer">
    <p class="trip-price-note">Valores e parcelamento sob consulta no WhatsApp</p>

    <a
      href={waUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-whatsapp trip-wa-btn"
    >
      <WhatsAppIcon size={18} />
      Consultar valores no WhatsApp
    </a>

    <div class="trip-secondary-actions">
      <a href={detailUrl} class="trip-detail-link">
        Ver detalhes do roteiro →
      </a>
      <a
        href={shareUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="trip-share-btn"
        title="Compartilhar roteiro com família e amigos no WhatsApp"
        aria-label={`Compartilhar ${trip.title} no WhatsApp`}
      >
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="18" cy="5" r="3" />
          <circle cx="6" cy="12" r="3" />
          <circle cx="18" cy="19" r="3" />
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
        </svg>
        Indicar
      </a>
    </div>
  </div>
</article>

<style>
  .trip-card {
    background: var(--sb-surface);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform 0.24s ease, box-shadow 0.24s ease, border-color 0.24s ease;
    position: relative;
  }

  .trip-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--sb-border-strong);
  }

  .trip-media {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 16 / 10;
    min-height: 202px;
    padding: 1.05rem 1.2rem;
    color: #ffffff;
    overflow: hidden;
  }

  .trip-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 0;
  }

  .trip-card:hover .trip-media img {
    transform: scale(1.07);
  }

  .trip-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(9, 35, 56, 0.64) 0%,
      rgba(9, 35, 56, 0.16) 46%,
      rgba(9, 35, 56, 0.88) 100%
    );
    z-index: 1;
  }

  /* Moldura editorial fina que surge no hover da foto */
  .trip-media-frame {
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 10px;
    opacity: 0;
    transform: scale(0.97);
    transition: opacity 0.28s ease, transform 0.28s ease;
    pointer-events: none;
    z-index: 2;
  }

  .trip-card:hover .trip-media-frame {
    opacity: 1;
    transform: scale(1);
  }

  .trip-banner-top,
  .trip-date-box {
    position: relative;
    z-index: 3;
  }

  .trip-banner-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .trip-modality {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(9, 35, 56, 0.76);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(6px);
    padding: 0.28rem 0.72rem;
    border-radius: 999px;
  }

  .trip-tag {
    font-size: 0.78rem;
    font-weight: 700;
    background: var(--sb-warm-soft);
    color: var(--sb-red-dark);
    border: 1px solid rgba(253, 230, 138, 0.9);
    padding: 0.26rem 0.72rem;
    border-radius: 999px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.16);
  }

  .trip-month {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sb-warm-light);
  }

  .trip-dates {
    font-family: var(--font-display);
    font-size: 1.24rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.38);
  }

  .trip-body {
    padding: 1.35rem 1.35rem 0.95rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .trip-sector-link {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sb-blue-action);
    margin-bottom: 0.35rem;
  }

  .trip-sector-link:hover {
    color: var(--sb-blue-dark);
    text-decoration: underline;
  }

  .trip-title {
    font-family: var(--font-heading);
    font-size: 1.22rem;
    font-weight: 800;
    color: var(--sb-blue-deep);
    margin-bottom: 0.55rem;
    line-height: 1.25;
  }

  .trip-title a:hover {
    color: var(--sb-blue-action);
  }

  .trip-summary {
    font-size: 0.95rem;
    color: var(--sb-muted);
    margin-bottom: 1rem;
    line-height: 1.56;
  }

  .trip-highlights {
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
  }

  .trip-highlights li {
    position: relative;
    padding-left: 0.85rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--sb-blue-dark);
  }

  .trip-highlights li::before {
    content: '✦';
    position: absolute;
    left: 0;
    top: 0;
    font-size: 0.65rem;
    color: var(--sb-warm);
  }

  /* Divisória estilo bilhete de embarque */
  .trip-ticket-divider {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 1.35rem;
  }

  .ticket-line {
    flex: 1;
    border-top: 1.5px dashed var(--sb-border-strong);
  }

  .ticket-stamp {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #8b7f6e;
    white-space: nowrap;
  }

  .ticket-notch {
    position: absolute;
    top: 50%;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--card-cutout-bg);
    border: 1px solid var(--sb-border);
    transform: translateY(-50%);
  }

  .ticket-notch-left {
    left: -10px;
  }

  .ticket-notch-right {
    right: -10px;
  }

  .trip-footer {
    padding: 0.45rem 1.35rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .trip-price-note {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--sb-muted);
    margin: 0;
    text-align: center;
  }

  .trip-wa-btn {
    width: 100%;
    font-size: 0.92rem;
    padding: 0.82rem 1rem;
  }

  .trip-secondary-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  .trip-detail-link {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--sb-blue-action);
  }

  .trip-detail-link:hover {
    color: var(--sb-red-dark);
    text-decoration: underline;
  }

  .trip-share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--sb-blue-dark);
    background: var(--sb-bg);
    border: 1px solid var(--sb-border);
    padding: 0.34rem 0.78rem;
    border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .trip-share-btn:hover {
    background: var(--sb-blue-soft);
    border-color: var(--sb-blue);
    color: var(--sb-blue-deep);
  }
</style>
