---
import { HOW_IT_WORKS_STEPS } from '../data/viagens';

interface Props {
  altBackground?: boolean;
}

const { altBackground = false } = Astro.props;
---

<section class:list={['section', { 'section-alt': altBackground }]}>
  <div class="container">
    <div class="section-header center">
      <span class="eyebrow eyebrow-blue">Passo a passo simples</span>
      <h2 class="section-title">
        Como funciona viajar <span class="h2-serif">sem preocupação</span>
      </h2>
      <p class="section-subtitle">
        Um processo transparente, sem burocracia e com atendimento humano do primeiro contato até o seu retorno a Fortaleza.
      </p>
    </div>

    <div class="steps-grid">
      {HOW_IT_WORKS_STEPS.map((item) => (
        <div class="step-card">
          <div class="step-top">
            <span class="step-number">{item.step}</span>
            <span class="step-rule" aria-hidden="true"></span>
            <span class="step-dot" aria-hidden="true"></span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .step-card {
    background: var(--sb-surface);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-md);
    padding: 1.75rem 1.55rem;
    box-shadow: var(--shadow-sm);
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .step-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--sb-border-strong);
  }

  .step-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.15rem;
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 0.9;
    color: var(--sb-blue-action);
    letter-spacing: -0.04em;
  }

  .step-rule {
    flex: 1;
    height: 1px;
    background: var(--sb-border-strong);
  }

  .step-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sb-red);
    flex-shrink: 0;
  }

  .step-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .step-card p {
    font-size: 0.95rem;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .steps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
