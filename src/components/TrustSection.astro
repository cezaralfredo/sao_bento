---
import { COMPANY, getWhatsAppUrl } from '../data/viagens';

const feedbackWaUrl = getWhatsAppUrl(
  'Olá, São Bento Turismo! Já viajei com vocês e gostaria de deixar meu depoimento ou saber sobre as próximas saídas.'
);
---

<section class="section section-alt">
  <div class="container">
    <div class="trust-strip">
      <div class="trust-item">
        <div class="trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <div>
          <strong>Agência Ativa desde 2006</strong>
          <span>CNPJ {COMPANY.cnpj}</span>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-icon trust-icon-red" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div>
          <strong>Famílias & Melhor Idade</strong>
          <span>Tradição no acolhimento de grupos</span>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <div>
          <strong>Embarques em Fortaleza</strong>
          <span>Sede na região Sapiranga / Edson Queiroz</span>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-icon trust-icon-wa" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
        </div>
        <div>
          <strong>Atendimento Humano</strong>
          <span>Fale direto com quem organiza</span>
        </div>
      </div>
    </div>

    <div class="community-box">
      <div class="community-copy">
        <span class="eyebrow">Comunidade de Viajantes</span>
        <h3>Viajou com a São Bento Turismo? Sua opinião ajuda novas famílias a embarcarem com confiança!</h3>
        <p>
          Nossos grupos crescem há 20 anos pela indicação de amigos, famílias e comunidades paroquiais de Fortaleza. Em breve reuniremos aqui os relatos e fotos enviados pelos nossos passageiros.
        </p>
      </div>
      <div class="community-actions">
        <a href={feedbackWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          Enviar meu depoimento no WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.2rem;
    margin-bottom: 2.25rem;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: var(--sb-bg);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-md);
    padding: 1.15rem 1.2rem;
  }

  .trust-icon {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--sb-blue-soft);
    color: var(--sb-blue-dark);
    display: grid;
    place-items: center;
  }

  .trust-icon-red {
    background: var(--sb-red-soft);
    color: var(--sb-red);
  }

  .trust-icon-wa {
    background: #e6f6ec;
    color: var(--sb-wa);
  }

  .trust-item strong {
    display: block;
    font-size: 0.94rem;
    color: var(--sb-blue-deep);
    line-height: 1.25;
  }

  .trust-item span {
    display: block;
    font-size: 0.82rem;
    color: var(--sb-muted);
    margin-top: 2px;
  }

  .community-box {
    background: var(--sb-bg);
    border: 1px solid var(--sb-border);
    border-radius: var(--radius-lg);
    padding: 2rem 2.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .community-copy {
    max-width: 680px;
  }

  .community-copy h3 {
    font-size: 1.32rem;
    margin-bottom: 0.45rem;
  }

  .community-copy p {
    margin: 0;
    font-size: 0.95rem;
  }

  @media (max-width: 1024px) {
    .trust-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .trust-strip {
      grid-template-columns: 1fr;
    }
    .community-box {
      padding: 1.5rem;
    }
  }
</style>
